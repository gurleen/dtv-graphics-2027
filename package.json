    "ograf:build:basketball-v2-player-of-the-game-lower-third": "bun ograf/scripts/build_package.ts ograf/graphics/basketball_v2_player_of_the_game_lower_third",
    "ograf:build:basketball-v2-team-lower-third": "bun ograf/scripts/build_package.ts ograf/graphics/basketball_v2_team_lower_third",
    "ograf:build:basketball-v2-halftime-statistics": "bun ograf/scripts/build_package.ts ograf/graphics/basketball_v2_halftime_statistics",
