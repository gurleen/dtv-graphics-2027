{
  "name": "dtv-rive-preview",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run preview:generate && vite",
    "build": "bun run preview:generate && vite build",
    "preview": "vite preview",
    "preview:generate": "bun preview/scripts/generate.ts",
    "rive:dev": "rive .",
    "rive:build": "rive . --publish",
    "ograf:build": "bun run ograf:build:v2",
    "ograf:build:v2": "bun run ograf:build:basketball-v2-scorebug && bun run ograf:build:basketball-v2-lower-third && bun run ograf:build:basketball-v2-staff-lower-third && bun run ograf:build:basketball-v2-matchup-locator && bun run ograf:build:basketball-v2-talent-lower-third-single && bun run ograf:build:basketball-v2-talent-lower-third-double && bun run ograf:build:basketball-v2-talent-lower-third-triple && bun run ograf:build:basketball-v2-starting-five-lower-third",
    "ograf:build:basketball-v2-scorebug": "bun ograf/scripts/build_package.ts ograf/graphics/basketball_v2_scorebug",
    "ograf:build:basketball-v2-lower-third": "bun ograf/scripts/build_package.ts ograf/graphics/basketball_v2_player_lower_third",
    "ograf:build:basketball-v2-staff-lower-third": "bun ograf/scripts/build_package.ts ograf/graphics/basketball_v2_staff_lower_third",
    "ograf:build:basketball-v2-starting-five-lower-third": "bun ograf/scripts/build_package.ts ograf/graphics/basketball_v2_starting_five_lower_third",
    "ograf:build:basketball-v2-matchup-locator": "bun ograf/scripts/build_package.ts ograf/graphics/basketball_v2_matchup_locator",
    "ograf:build:basketball-v2-talent-lower-third-single": "bun ograf/scripts/build_package.ts ograf/graphics/basketball_v2_talent_lower_third_single",
    "ograf:build:basketball-v2-talent-lower-third-double": "bun ograf/scripts/build_package.ts ograf/graphics/basketball_v2_talent_lower_third_double",
    "ograf:build:basketball-v2-talent-lower-third-triple": "bun ograf/scripts/build_package.ts ograf/graphics/basketball_v2_talent_lower_third_triple",
    "ograf:harness": "bun ograf/harness/serve.ts"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.42.1",
    "@rive-app/canvas-advanced": "^2.42.1",
    "@rive-app/canvas-single": "^2.42.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.20.0",
    "ograf": "^1.2.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
