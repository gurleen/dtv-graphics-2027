    "ograf:build:basketball-v2-burning-question": "bun ograf/scripts/build_package.ts ograf/graphics/basketball_v2_burning_question",
    "ograf:build:basketball-v2-score-to-break": "bun ograf/scripts/build_package.ts ograf/graphics/basketball_v2_score_to_break",
    "ograf:build:basketball-v2-matchup-locator": "bun ograf/scripts/build_package.ts ograf/graphics/basketball_v2_matchup_locator",
    "ograf:build:basketball-v2-matchup-locator-lower-third": "bun ograf/scripts/build_package.ts ograf/graphics/basketball_v2_matchup_locator_lower_third",
