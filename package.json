{
  "name": "dtv-rive-preview",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "graphics/*"
  ],
  "scripts": {
    "check": "tsc -p . && tsc -p tsconfig.browser.json && bun scripts/check_deps.ts && bun run codegen --check && bun test",
    "codegen": "bun packages/playout/scripts/scene-codegen.ts graphics/basketball-v2",
    "dev": "bun --watch apps/server/src/main.ts",
    "start": "bun apps/server/src/main.ts",
    "db:migrate": "bun packages/db/scripts/db.ts migrate",
    "db:seed": "bun packages/db/scripts/db.ts seed",
    "db:backup": "bun packages/db/scripts/db.ts backup",
    "rive:dev": "rive .",
    "rive:build": "rive . --publish",
    "riv:build": "bun scripts/build_riv.ts",
    "site:build": "bun run riv:build && bun run site:assemble",
    "site:assemble": "bun apps/site/scripts/build.ts",
    "site:preview": "wrangler dev",
    "site:serve": "bun apps/site/scripts/serve.ts",
    "site:screenshots": "bun apps/site/scripts/screenshots.ts",
    "site:deploy": "wrangler deploy",
    "headshots:push": "bun scripts/headshots.ts push",
    "live:statcrew": "bun packages/live-statcrew/src/main.ts"
  },
  "dependencies": {
    "@rive-app/canvas-single": "^2.42.2"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/bun": "^1.4.3",
    "typescript": "^5.9.2",
    "wrangler": "^4.143.1"
  }
}
