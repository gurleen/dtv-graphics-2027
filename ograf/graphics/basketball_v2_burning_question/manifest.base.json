{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "dtv-basketball-v2-burning-question",
  "version": "1.0.0",
  "name": "Basketball v2 Burning Question",
  "description": "DTV basketball trivia question in the bottom-right corner, presented by Steamfitters Local 420: the question on team-tinted glass, with an answer strip that Show Answer opens beneath it (animated on air). It clears the scorebug, so the two can be on air together.",
  "author": { "name": "Dragons TV", "url": "https://dragonstv.io" },
  "main": "index.mjs",
