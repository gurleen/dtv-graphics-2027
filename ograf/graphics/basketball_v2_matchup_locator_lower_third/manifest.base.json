{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "dtv-basketball-v2-matchup-locator-lower-third",
  "version": "1.0.0",
  "name": "Basketball v2 Matchup Locator Lower Third",
  "description": "DTV pre-game matchup banner across the lower third: tinted glass team panels, each with its logo large and cropped at the outer end beside the school, mascot and records, a VS panel with an optional event title, and a venue and sponsor strip. Overlaps the scorebug; take the scorebug off air first.",
  "author": {
    "name": "Dragons TV",
    "url": "https://dragonstv.io"
  },
  "main": "index.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "actionDurations": [
    { "type": "playAction", "duration": 1400 },
    { "type": "stopAction", "duration": 400 },
    { "type": "updateAction", "duration": -1 }
  ],
  "renderRequirements": [
    {
      "resolution": { "width": { "ideal": 1920 }, "height": { "ideal": 1080 } },
      "frameRate": { "min": 50 },
      "accessToPublicInternet": { "ideal": true }
    }
  ],
  "thumbnails": [
    { "file": "thumbnail.png", "resolution": { "width": 1920, "height": 1080 } }
  ]
}
