{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "dtv-basketball-v2-starting-five-lower-third",
  "version": "1.0.1",
  "name": "Basketball v2 Starting Five Lower Third",
  "description": "DTV basketball starting lineups beside the scorebug, presented by Independence Blue Cross. Step 0 shows the away team's starting five, step 1 the home team's; advancing on air changes team without leaving air.",
  "author": { "name": "Dragons TV", "url": "https://dragonstv.io" },
  "main": "index.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 2,
  "actionDurations": [
    {
      "type": "playAction",
      "duration": 1400,
      "steps": [
        { "step": 0, "duration": 1400 },
        { "step": 1, "duration": 1000 }
      ]
    },
    { "type": "stopAction", "duration": 400 },
    { "type": "updateAction", "duration": -1 }
  ],
  "renderRequirements": [
    {
      "resolution": { "width": { "ideal": 1920 }, "height": { "ideal": 1080 } },
      "frameRate": { "min": 50 },
      "accessToPublicInternet": { "ideal": true }
    }
  ],
  "thumbnails": [
    { "file": "thumbnail.png", "resolution": { "width": 1920, "height": 1080 } }
  ]
}
