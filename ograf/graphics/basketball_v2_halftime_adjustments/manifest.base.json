{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "dtv-basketball-v2-halftime-adjustments",
  "version": "1.0.0",
  "name": "Basketball v2 Halftime Adjustments",
  "description": "DTV basketball halftime adjustments in the bottom-left corner, presented by Rothman Orthopaedics. Two short lines per team over the halftime score. Step 0 shows the away team, step 1 the home team; advancing on air changes team without leaving air. Not for use with the scorebug, which occupies the same corner.",
  "author": { "name": "Dragons TV", "url": "https://dragonstv.io" },
  "main": "index.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 2,
  "actionDurations": [
    {
      "type": "playAction",
      "duration": 1200,
      "steps": [
        { "step": 0, "duration": 1200 },
        { "step": 1, "duration": 800 }
      ]
    },
    { "type": "stopAction", "duration": 400 },
    { "type": "updateAction", "duration": -1 }
  ],
  "renderRequirements": [
    {
      "resolution": { "width": { "ideal": 1920 }, "height": { "ideal": 1080 } },
      "frameRate": { "min": 50 },
      "accessToPublicInternet": { "ideal": true }
    }
  ],
  "thumbnails": [
    { "file": "thumbnail.png", "resolution": { "width": 1920, "height": 1080 } }
  ]
}
