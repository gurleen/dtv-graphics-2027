{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "dtv-basketball-v2-conference-standings",
  "version": "1.0.0",
  "name": "Basketball v2 Conference Standings",
  "description": "DTV CAA standings card: the thirteen conference teams in order, each with its conference record, overall record and streak, and the rows of the night's away and home teams tinted in their colours. Clears the scorebug.",
  "author": { "name": "Dragons TV", "url": "https://dragonstv.io" },
  "main": "index.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "actionDurations": [
    { "type": "playAction", "duration": 1500 },
    { "type": "stopAction", "duration": 400 },
    { "type": "updateAction", "duration": -1 }
  ],
  "renderRequirements": [
    {
      "resolution": { "width": { "ideal": 1920 }, "height": { "ideal": 1080 } },
      "frameRate": { "min": 50 },
      "accessToPublicInternet": { "ideal": true }
    }
  ],
  "thumbnails": [
    { "file": "thumbnail.png", "resolution": { "width": 1920, "height": 1080 } }
  ]
}
