{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "dtv-basketball-v2-player-of-the-game-lower-third",
  "version": "1.0.0",
  "name": "Basketball v2 Player of the Game Lower Third",
  "description": "DTV post-game Player of the Game feature, presented by Steamfitters Local 420: headshot (still or looping video), player details, and up to four stats or two lines of copy. Overlaps the scorebug; take the scorebug off air first.",
  "author": { "name": "Dragons TV", "url": "https://dragonstv.io" },
  "main": "index.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "actionDurations": [
    { "type": "playAction", "duration": 1400 },
    { "type": "stopAction", "duration": 400 },
    { "type": "updateAction", "duration": -1 }
  ],
  "renderRequirements": [
    {
      "resolution": { "width": { "ideal": 1920 }, "height": { "ideal": 1080 } },
      "frameRate": { "min": 50 },
      "accessToPublicInternet": { "ideal": true }
    }
  ],
  "thumbnails": [
    { "file": "thumbnail.png", "resolution": { "width": 1920, "height": 1080 } }
  ]
}
