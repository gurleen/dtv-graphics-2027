{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "dtv-basketball-v2-matchup-locator",
  "version": "1.0.0",
  "name": "Basketball v2 Matchup Locator",
  "description": "DTV basketball matchup locator with tinted glass team panels, full-colour logos, records and venue sponsor strip.",
  "author": {
    "name": "Dragons TV",
    "url": "https://dragonstv.io"
  },
  "main": "index.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "actionDurations": [
    { "type": "playAction", "duration": 1433 },
    { "type": "stopAction", "duration": 400 },
    { "type": "updateAction", "duration": -1 }
  ],
  "renderRequirements": [
    {
      "resolution": { "width": { "ideal": 1920 }, "height": { "ideal": 1080 } },
      "frameRate": { "min": 50 },
      "accessToPublicInternet": { "ideal": true }
    }
  ],
  "thumbnails": [
    { "file": "thumbnail.png", "resolution": { "width": 1920, "height": 1080 } }
  ]
}
