// Browser code (the renderer, the /renderer page and the site), checked with the DOM's types; the
// scripts/ beside them run in Bun and stay in the root config. The root config leaves the
// browser files out because the DOM's ReadableStream hides Bun's async iterator.
{
  "extends": "./tsconfig.json",
  "compilerOptions": { "lib": ["ES2023", "DOM", "DOM.Iterable"] },
  "include": ["packages/renderer", "apps/renderer/*.ts", "apps/site/*.ts"],
  "exclude": []
}
