<Rive version="1" kind="fragment">
<!-- Basketball matchup locator v2: a centred card, 1200 x 560, on a transparent
     1920 x 1080 canvas (origin 360, 260). Away and home halves (team tint), each
     with a secondary-colour stripe along its top edge, carry a large logo over
     the school name and record; a round dark glass VS medallion sits on the seam
     between them, and a dark glass strip below carries the venue and the sponsor.
     Sibling draw order is front to back; within one shape the last paint
     declared is on top. -->
<Artboard name="Basketball Matchup Locator v2" id="32:2" x="0" y="5000" width="1920" height="1080" viewModelId="32:1000" viewModelInstanceId="32:1001" defaultStateMachineId="32:7" styleId="32:5">
<LayoutComponentStyle name="Matchup Locator v2 Style" id="32:5"/>
<Fill><SolidColor colorValue="00000000"/></Fill>

<Node name="Matchup Card" id="32:10" x="360" y="260">

<!-- =========================== Specular sweep =========================== -->
<!-- The intro's closing flourish: one soft diagonal sheen crosses the glass from
     left to right, clipped to the card silhouette. Invisible at rest. -->
<Shape name="Card Specular Sweep" id="32:600" x="1460" y="280" rotation="0.3490659" opacity="0">
  <Rectangle width="180" height="1000" originX="0.5" originY="0.5"/>
  <Fill><LinearGradient startX="-90" startY="0" endX="90" endY="0"><GradientStop colorValue="00FFFFFF" position="0"/><GradientStop colorValue="24FFFFFF" position="0.5"/><GradientStop colorValue="00FFFFFF" position="1"/></LinearGradient></Fill>
  <ClippingShape name="Card Specular Sweep Clip" sourceId="32:610"/>
</Shape>

<!-- ============================ VS medallion ============================ -->
<!-- Centred on the seam, level with the logo centres; its origin is the disc
     centre so it scales in place. -->
<Node name="Versus Medallion" id="32:300" x="600" y="186">
  <Text name="Versus" id="32:301" x="-62" y="21" originValue="baseline" wrapValue="noWrap" width="124" sizingValue="fixed" alignValue="center"><TextStylePaint id="32:320" fontAssetId="32:900" fontSize="60" letterSpacing="1"><Fill><SolidColor colorValue="E6FFFFFF"/></Fill></TextStylePaint><TextValueRun name="Versus Value" styleId="32:320" text="VS"></TextValueRun></Text>
  <!-- Drawn on clockwise from twelve o'clock during the intro, then faded out;
       invisible at rest. -->
  <Shape name="Versus Ring" id="32:305" x="0" y="0" opacity="0">
    <Ellipse width="136" height="136"/>
    <Stroke thickness="2" cap="round"><SolidColor colorValue="E6FFFFFF"/><TrimPath name="Versus Ring Trim" id="32:306" start="0" end="1"/></Stroke>
  </Shape>
  <Shape name="Versus Glaze" x="0" y="0">
    <Ellipse width="124" height="124"/>
    <Fill><LinearGradient startX="0" startY="-62" endX="0" endY="62"><GradientStop colorValue="00000000" position="0"/><GradientStop colorValue="40000000" position="1"/></LinearGradient></Fill>
    <Stroke thickness="1.5"><LinearGradient startX="0" startY="-62" endX="0" endY="62"><GradientStop colorValue="73FFFFFF" position="0"/><GradientStop colorValue="0FFFFFFF" position="0.6"/></LinearGradient></Stroke>
  </Shape>
  <Shape name="Versus Body" x="0" y="0">
    <Ellipse width="124" height="124"/>
    <Fill><SolidColor colorValue="E00E1116"/></Fill>
  </Shape>
  <Shape name="Versus Shadow" x="0" y="3">
    <Ellipse width="124" height="124"/>
    <Stroke thickness="8"><SolidColor colorValue="99000000"/><Feather strength="14"/></Stroke>
  </Shape>
</Node>

<!-- ======================== Intro leading edges ======================== -->
<!-- Each edge carries an unpainted mask that reveals its half as the edge travels
     out from the seam, and a light that rides the mask edge with a gradient
     trailing over the revealed glass. At rest the edges sit past the outer card
     edges, so the masks are fully open, and the lights are off. The masks are
     wide enough to cover the halves while the outro draws them inward. -->
<Node name="Away Leading Edge" id="32:500" x="-8" y="0">
  <Shape name="Away Reveal Mask" id="32:501" x="0" y="-8">
    <Rectangle width="900" height="482" originX="0" originY="0"/>
  </Shape>
  <!-- Its origin is level with the medallion centre, so the light extends from
       there when it ignites. -->
  <Node name="Away Edge Light" id="32:502" x="0" y="186" opacity="0">
    <Shape name="Away Edge Line" x="0" y="0">
      <Rectangle width="2" height="466" originX="0.5" originY="0.3991416"/>
      <Fill><SolidColor colorValue="E6FFFFFF"/></Fill>
    </Shape>
    <Shape name="Away Edge Glow" x="0" y="0">
      <Rectangle width="44" height="466" originX="0" originY="0.3991416"/>
      <Fill><LinearGradient startX="0" startY="0" endX="44" endY="0"><GradientStop colorValue="30FFFFFF" position="0"/><GradientStop colorValue="00FFFFFF" position="1"/></LinearGradient></Fill>
    </Shape>
  </Node>
</Node>
<Node name="Home Leading Edge" id="32:505" x="1208" y="0">
  <Shape name="Home Reveal Mask" id="32:506" x="0" y="-8">
    <Rectangle width="900" height="482" originX="1" originY="0"/>
  </Shape>
  <Node name="Home Edge Light" id="32:507" x="0" y="186" opacity="0">
    <Shape name="Home Edge Line" x="0" y="0">
      <Rectangle width="2" height="466" originX="0.5" originY="0.3991416"/>
      <Fill><SolidColor colorValue="E6FFFFFF"/></Fill>
    </Shape>
    <Shape name="Home Edge Glow" x="0" y="0">
      <Rectangle width="44" height="466" originX="1" originY="0.3991416"/>
      <Fill><LinearGradient startX="0" startY="0" endX="-44" endY="0"><GradientStop colorValue="30FFFFFF" position="0"/><GradientStop colorValue="00FFFFFF" position="1"/></LinearGradient></Fill>
    </Shape>
  </Node>
</Node>

<!-- =============================== Away half =============================== -->
<Node name="Away Half" id="32:100" x="0" y="0">
  <!-- The stripe is clipped by the tint, so it follows the rounded outer corner.
       It is anchored at the seam end and sits outside the reveal mask, so the
       intro can draw it outward ahead of the leading edge. -->
  <Shape name="Away Marker" id="32:101" x="598" y="0">
    <Rectangle width="598" height="6" originX="1" originY="0"/>
    <Fill><SolidColor colorValue="FF101010"><DataBindContext sourcePathIds="32:1000-32:1024" propertyKey="37"/></SolidColor></Fill>
    <ClippingShape name="Away Marker Clip" sourceId="32:130"/>
  </Shape>
  <!-- A light hairline under the stripe keeps a dark secondary colour legible. -->
  <Shape name="Away Marker Hairline" id="32:102" x="598" y="6">
    <Rectangle width="598" height="1" originX="1" originY="0"/>
    <Fill><SolidColor colorValue="59FFFFFF"/></Fill>
    <ClippingShape name="Away Marker Hairline Clip" sourceId="32:130"/>
  </Shape>
  <!-- Everything else in the half is revealed by the away leading edge. -->
  <Node name="Away Panel" id="32:150" x="0" y="0">
    <ClippingShape name="Away Reveal Clip" sourceId="32:501"/>
    <!-- The intro drifts the content outward behind the leading edge, more
         slowly than the edge, so the glass appears to open over it. -->
    <Node name="Away Content" id="32:151" x="0" y="0">
      <Text name="Away School" x="40" y="368" originValue="baseline" wrapValue="noWrap" width="518" height="96" sizingValue="fixed" overflowValue="fitFontSize" alignValue="center"><TextStylePaint id="32:120" fontAssetId="32:900" fontSize="84" letterSpacing="0.5"><Fill><SolidColor colorValue="FFFFFFFF"/></Fill></TextStylePaint><TextValueRun name="Away School Value" styleId="32:120" text="SAINT JOSEPH'S"><DataBindContext sourcePathIds="32:1000-32:1010" propertyKey="268"/></TextValueRun>
        <!-- Fully modified glyphs are transparent and 30 below the baseline. The
             intro sweeps the range from the seam end to the start of the name,
             so the letters rise in one at a time, outward from the seam. At rest
             the range lies before the first glyph and nothing is modified. -->
        <TextModifierGroup name="Away School Cascade" modifyOpacity="true" modifyTranslation="true" invertOpacity="true" opacity="0" y="30">
          <TextModifierRange name="Away School Cascade Range" id="32:156" unitsValue="1" modifyFrom="-1" falloffFrom="-1" falloffTo="-0.45" modifyTo="0">
            <CubicInterpolatorComponent name="Away School Cascade Ease" x1="0.42" y1="0" x2="0.58" y2="1"/>
          </TextModifierRange>
        </TextModifierGroup>
      </Text>
      <Text name="Away Record" x="40" y="420" originValue="baseline" wrapValue="noWrap" width="518" sizingValue="fixed" alignValue="center">
        <TextStylePaint id="32:121" fontAssetId="32:900" fontSize="40" letterSpacing="1"><Fill><SolidColor colorValue="FFFFFFFF"/></Fill></TextStylePaint>
        <TextStylePaint id="32:122" fontAssetId="32:901" fontSize="34" letterSpacing="2"><Fill><SolidColor colorValue="B3FFFFFF"/></Fill></TextStylePaint>
        <TextValueRun name="Away Overall Record Value" styleId="32:121" text="15-5"><DataBindContext sourcePathIds="32:1000-32:1012" propertyKey="268"/></TextValueRun>
        <TextValueRun name="Away Record Separator" styleId="32:122" text="  ·  "><DataBindContext sourcePathIds="32:1000-32:1014" propertyKey="268" converterId="32:960"/></TextValueRun>
        <TextValueRun name="Away Conference Record Value" styleId="32:122" text="7-2 A10"><DataBindContext sourcePathIds="32:1000-32:1014" propertyKey="268"/></TextValueRun>
        <TextModifierGroup name="Away Record Cascade" modifyOpacity="true" modifyTranslation="true" invertOpacity="true" opacity="0" y="20">
          <TextModifierRange name="Away Record Cascade Range" id="32:158" unitsValue="1" modifyFrom="-1" falloffFrom="-1" falloffTo="-0.45" modifyTo="0">
            <CubicInterpolatorComponent name="Away Record Cascade Ease" x1="0.42" y1="0" x2="0.58" y2="1"/>
          </TextModifierRange>
        </TextModifierGroup>
      </Text>
      <!-- 340 units square (the 1024 source at 0.332); a logo fills about 70% of
           its padded source, so it draws at about 240. Centred on the group so
           it scales in place. -->
      <Node name="Away Logo Group" id="32:140" x="299" y="186">
        <Image name="Away Logo" x="0" y="0" scaleX="0.332" scaleY="0.332" assetId="32:910"><DataBindContext sourcePathIds="32:1000-32:1020" propertyKey="206"/></Image>
      </Node>
      <!-- A soft light bloom behind the logo, as if the glass were lit from behind. -->
      <Shape name="Away Logo Bloom" id="32:154" x="299" y="186">
        <Ellipse width="480" height="480"/>
        <Fill><RadialGradient startX="0" startY="0" endX="240" endY="0"><GradientStop colorValue="2EFFFFFF" position="0"/><GradientStop colorValue="12FFFFFF" position="0.45"/><GradientStop colorValue="00FFFFFF" position="1"/></RadialGradient></Fill>
        <ClippingShape name="Away Logo Bloom Clip" sourceId="32:130"/>
      </Shape>
    </Node>
    <Shape name="Away Glaze" x="0" y="0">
      <Rectangle width="598" height="466" originX="0" originY="0" linkCornerRadius="false" cornerRadiusTL="24" cornerRadiusTR="6" cornerRadiusBL="6" cornerRadiusBR="6"/>
      <Fill><LinearGradient startX="0" startY="0" endX="0" endY="466"><GradientStop colorValue="00000000" position="0"/><GradientStop colorValue="4D000000" position="1"/></LinearGradient></Fill>
      <Stroke thickness="1"><LinearGradient startX="0" startY="0" endX="0" endY="466"><GradientStop colorValue="73FFFFFF" position="0"/><GradientStop colorValue="0FFFFFFF" position="0.6"/></LinearGradient></Stroke>
    </Shape>
    <Shape name="Away Tint" id="32:130" x="0" y="0" opacity="0.78">
      <Rectangle width="598" height="466" originX="0" originY="0" linkCornerRadius="false" cornerRadiusTL="24" cornerRadiusTR="6" cornerRadiusBL="6" cornerRadiusBR="6"/>
      <Fill><SolidColor colorValue="FFC2071B"><DataBindContext sourcePathIds="32:1000-32:1022" propertyKey="37"/></SolidColor></Fill>
    </Shape>
    <Shape name="Away Underlay" x="0" y="0">
      <Rectangle width="598" height="466" originX="0" originY="0" linkCornerRadius="false" cornerRadiusTL="24" cornerRadiusTR="6" cornerRadiusBL="6" cornerRadiusBR="6"/>
      <Fill><SolidColor colorValue="59000000"/></Fill>
    </Shape>
  </Node>
</Node>

