<!-- Intro, 1.43 s at 60 fps. A light ignites on the seam and splits into two
     leading edges that wipe the halves open outward (in-out, 0.63 s), each team
     stripe running just ahead of its edge; the content drifts outward behind the
     edges, the logos settle from 112% as their blooms spread, and the names and
     records rise in letter by letter, outward from the seam. The medallion forms
     on the seam with a ring drawn round it, the venue strip slides down from
     under the halves, and one specular sweep crosses the glass to finish. Every
     ease decelerates without overshoot. The first block restores what Outro and
     Hidden change. -->
<LinearAnimation name="Intro" id="32:31" fps="60" duration="86" loopValue="oneShot">
  <KeyedObject objectId="32:100"><KeyedProperty propertyKey="13"><KeyFrameDouble frame="0" value="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
  <KeyedObject objectId="32:100"><KeyedProperty propertyKey="18"><KeyFrameDouble frame="0" value="1" interpolationType="hold"/></KeyedProperty></KeyedObject>
  <KeyedObject objectId="32:200"><KeyedProperty propertyKey="13"><KeyFrameDouble frame="0" value="602" interpolationType="hold"/></KeyedProperty></KeyedObject>
  <KeyedObject objectId="32:200"><KeyedProperty propertyKey="18"><KeyFrameDouble frame="0" value="1" interpolationType="hold"/></KeyedProperty></KeyedObject>
  <KeyedObject objectId="32:400"><KeyedProperty propertyKey="18"><KeyFrameDouble frame="0" value="1" interpolationType="hold"/></KeyedProperty></KeyedObject>

  <!-- Ignition: the seam light extends from the medallion height, then fades as
       the edges carry it outward. The fade is the package ease-out, so the light
       is mostly gone before the edges cross the team tints: white glow lightens a
       dark tint about twice as much as a bright one, and a lingering glow made
       the edge over a dark team read brighter than the other. -->
  <KeyedObject objectId="32:502"><KeyedProperty propertyKey="17">
    <KeyFrameDouble frame="0" value="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.22" y1="1" x2="0.36" y2="1"/></KeyFrameDouble>
    <KeyFrameDouble frame="16" value="1" interpolationType="hold"/>
  </KeyedProperty></KeyedObject>
  <KeyedObject objectId="32:502"><KeyedProperty propertyKey="18">
    <KeyFrameDouble frame="0" value="0" interpolationType="linear"/>
    <KeyFrameDouble frame="2" value="1" interpolationType="linear"/>
    <KeyFrameDouble frame="18" value="1" interpolationType="cubic"><CubicEaseInterpolator x1="0.16" y1="1" x2="0.3" y2="1"/></KeyFrameDouble>
    <KeyFrameDouble frame="42" value="0" interpolationType="hold"/>
