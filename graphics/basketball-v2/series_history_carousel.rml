  </Shape>
</Node>
  <!-- The card's dark glass, behind every panel, so the seams read as glass. -->
  <Shape name="Card Backing"><Rectangle width="1488" height="704" originX="0" originY="0" linkCornerRadius="false" cornerRadiusTL="24" cornerRadiusTR="24" cornerRadiusBL="24" cornerRadiusBR="24"/><Fill><SolidColor colorValue="D10E1116"/></Fill></Shape>
</Node>

<!-- Clip sources: unpainted, so they draw nothing. The reveal mask opens from the seam
     between the feature and the list, both ways at once; at rest it covers the card. -->
<Shape name="Card Reveal Mask" id="54:505">
  <Rectangle id="54:506" x="882" y="-8" width="890" height="720" originX="1" originY="0"/>
  <Rectangle id="54:507" x="882" y="-8" width="614" height="720" originX="0" originY="0"/>
</Shape>
<Shape name="Card Silhouette" id="54:610">
  <Rectangle width="1488" height="704" originX="0" originY="0" linkCornerRadius="false" cornerRadiusTL="24" cornerRadiusTR="24" cornerRadiusBL="24" cornerRadiusBR="24"/>
</Shape>
</Node>

