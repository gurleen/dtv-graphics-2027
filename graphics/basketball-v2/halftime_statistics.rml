  <Rectangle id="39:21" width="1356" height="636" originX="0.5" originY="0" cornerRadiusTL="24"/>
  <Stroke thickness="10"><SolidColor colorValue="99000000"/><Feather strength="18"/></Stroke>
</Shape>

