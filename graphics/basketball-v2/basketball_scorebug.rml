      <Fill><LinearGradient startX="0" startY="0" endX="0" endY="64"><GradientStop colorValue="00000000" position="0"/><GradientStop colorValue="4D000000" position="1"/></LinearGradient></Fill>
      <Stroke thickness="1"><LinearGradient startX="0" startY="0" endX="0" endY="64"><GradientStop colorValue="73FFFFFF" position="0"/><GradientStop colorValue="0FFFFFFF" position="0.6"/></LinearGradient></Stroke>
