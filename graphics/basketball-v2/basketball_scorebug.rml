          <Text name="Away Incoming Score" x="0" y="116" originValue="baseline" wrapValue="noWrap" width="114" sizingValue="fixed" alignValue="right"><TextStylePaint id="30:125" fontAssetId="30:900" fontSize="60" letterSpacing="0"><Fill><SolidColor colorValue="FFFFFFFF"/></Fill></TextStylePaint><TextValueRun name="Away Incoming Score Value" styleId="30:125" text="68"><DataBindContext sourcePathIds="30:1000-30:1051" propertyKey="268"/></TextValueRun></Text>
