        <Shape name="Away Bonus Pill"><Rectangle width="46" height="20" originX="0" originY="0" cornerRadiusTL="10"/>
          <Fill><SolidColor colorValue="26FFFFFF"/></Fill><Stroke thickness="1"><SolidColor colorValue="A6FFFFFF"/></Stroke></Shape>
