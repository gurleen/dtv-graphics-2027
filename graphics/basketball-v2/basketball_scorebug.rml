<Rive version="1" kind="fragment">
<!-- Basketball scorebug v2: a stacked tinted-glass corner block, 430 x 132, at the
     bottom left of a transparent 1920 x 1080 canvas (origin 96, 890). Away row on
     top, home row below, dark glass clock panel on the right. Sibling draw order
     is front to back; within one shape the last paint declared is on top. -->
<Artboard name="Basketball Scorebug v2" id="30:2" x="0" y="2600" width="1920" height="1080" viewModelId="30:1000" viewModelInstanceId="30:1001" defaultStateMachineId="30:7" styleId="30:5">
<LayoutComponentStyle name="Scorebug v2 Style" id="30:5"/>
<Fill><SolidColor colorValue="00000000"/></Fill>

<ScriptedDrawable name="Scorebug Controller" scriptAssetId="30:950"/>
<Node name="Scorebug" id="30:10" x="96" y="890">

<!-- =========================== Specular sweep =========================== -->
<!-- The intro's closing flourish: one soft diagonal sheen crosses the glass from
     left to right, clipped to the block silhouette. Invisible at rest. -->
<Shape name="Block Specular Sweep" id="30:600" x="520" y="66" rotation="0.3490659" opacity="0">
  <Rectangle width="60" height="400" originX="0.5" originY="0.5"/>
  <Fill><LinearGradient startX="-30" startY="0" endX="30" endY="0"><GradientStop colorValue="00FFFFFF" position="0"/><GradientStop colorValue="24FFFFFF" position="0.5"/><GradientStop colorValue="00FFFFFF" position="1"/></LinearGradient></Fill>
  <ClippingShape name="Block Specular Sweep Clip" sourceId="30:610"/>
</Shape>

<!-- ======================== Intro leading edges ======================== -->
<!-- The seam between the team rows and the clock panel is where the intro
     starts. Each edge carries an unpainted mask that reveals its side as the
     edge travels out from the seam, and a light that rides the mask edge with a
     gradient trailing over the revealed glass. At rest the edges sit past the
     outer block edges, so the masks are fully open, and the lights are off. The
     masks are tall and wide enough to cover the rows and the clock panel while
     the outro slides them. -->
<Node name="Rows Leading Edge" id="30:500" x="-8" y="0">
  <Shape name="Rows Reveal Mask" id="30:501" x="0" y="-60">
    <Rectangle width="600" height="300" originX="0" originY="0"/>
  </Shape>
  <!-- Its origin is level with the block centre, so the light extends from
       there when it ignites. -->
  <Node name="Rows Edge Light" id="30:502" x="0" y="66" opacity="0">
    <Shape name="Rows Edge Line" x="0" y="0">
      <Rectangle width="2" height="132" originX="0.5" originY="0.5"/>
      <Fill><SolidColor colorValue="F2FFFFFF"/></Fill>
    </Shape>
    <Shape name="Rows Edge Gradient" x="0" y="0">
      <Rectangle width="32" height="132" originX="0" originY="0.5"/>
      <Fill><LinearGradient startX="0" startY="0" endX="32" endY="0"><GradientStop colorValue="38FFFFFF" position="0"/><GradientStop colorValue="00FFFFFF" position="1"/></LinearGradient></Fill>
    </Shape>
  </Node>
</Node>
<Node name="Clock Leading Edge" id="30:505" x="440" y="0">
  <Shape name="Clock Reveal Mask" id="30:506" x="0" y="-60">
    <Rectangle width="600" height="300" originX="1" originY="0"/>
  </Shape>
  <Node name="Clock Edge Light" id="30:507" x="0" y="66" opacity="0">
    <Shape name="Clock Edge Line" x="0" y="0">
      <Rectangle width="2" height="132" originX="0.5" originY="0.5"/>
      <Fill><SolidColor colorValue="F2FFFFFF"/></Fill>
    </Shape>
    <Shape name="Clock Edge Gradient" x="0" y="0">
      <Rectangle width="32" height="132" originX="1" originY="0.5"/>
      <Fill><LinearGradient startX="0" startY="0" endX="-32" endY="0"><GradientStop colorValue="38FFFFFF" position="0"/><GradientStop colorValue="00FFFFFF" position="1"/></LinearGradient></Fill>
    </Shape>
  </Node>
</Node>

<!-- ============================== Away row ============================== -->
<Node name="Away Row" id="30:100" x="0" y="0">
  <!-- The marker sits outside the reveal mask, so the intro can draw it upward
       from the seam between the rows once the leading edge has passed. -->
  <Shape name="Away Marker" id="30:101" x="0" y="64">
    <Rectangle width="8" height="64" originX="0" originY="1" linkCornerRadius="false" cornerRadiusTL="12" cornerRadiusBL="3"/>
    <Fill><SolidColor colorValue="FFFFFFFF"><DataBindContext sourcePathIds="30:1000-30:1024" propertyKey="37"/></SolidColor></Fill>
  </Shape>
  <!-- Everything else in the row is revealed by the rows leading edge. -->
  <Node name="Away Panel" id="30:102" x="0" y="0">
    <ClippingShape name="Away Reveal Clip" sourceId="30:501"/>
    <!-- The intro drifts the content outward behind the leading edge, more
         slowly than the edge, so the glass appears to open over it. -->
    <Node name="Away Content" id="30:150" x="0" y="0">
      <!-- away content: acronym over timeout pips, bonus, possession, score -->
      <Node name="Away Score Window" id="30:110" x="112" y="0">
        <ClippingShape name="Away Score Clip" sourceId="30:111"/>
        <Node name="Away Score Reel" id="30:112"><DataBindContext sourcePathIds="30:1000-30:1052" propertyKey="14"/>
          <Text name="Away Score" x="0" y="52" originValue="baseline" wrapValue="noWrap" width="114" sizingValue="fixed" alignValue="right"><TextStylePaint id="30:120" fontAssetId="30:900" fontSize="60" letterSpacing="0"><Fill><SolidColor colorValue="FFFFFFFF"/></Fill></TextStylePaint><TextValueRun name="Away Score Value" styleId="30:120" text="68"><DataBindContext sourcePathIds="30:1000-30:1050" propertyKey="268"/></TextValueRun>
            <!-- Fully modified glyphs are transparent and 24 below the baseline.
                 The intro sweeps the range from the seam end to the start of the
                 text, so the digits rise in one at a time, outward from the seam.
                 At rest the range lies before the first glyph. -->
            <TextModifierGroup name="Away Score Cascade" modifyOpacity="true" modifyTranslation="true" invertOpacity="true" opacity="0" y="24">
              <TextModifierRange name="Away Score Cascade Range" id="30:152" unitsValue="1" modifyFrom="-1" falloffFrom="-1" falloffTo="-0.45" modifyTo="0">
                <CubicInterpolatorComponent name="Away Score Cascade Ease" x1="0.42" y1="0" x2="0.58" y2="1"/>
              </TextModifierRange>
