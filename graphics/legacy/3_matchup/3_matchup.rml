<Rive version="1" kind="fragment">
    <!--
        Matchup — port of dtv-graphics-2026/src/graphics/3_matchup.

        A 1920x1080 stack seated at y=700, three horizontal bands that
        together fill the remaining 380px of the canvas:
            700 .. 772   sponsor bar   (centered pill, sport-dependent text + sponsor mark)
            772 .. 961   main area     (away box 0..785 | conf box 785..1135 | home box 1135..1920)
            961 .. 1022  bottom bar    (venue line, full width, flush against the main area)
        785 + 350 + 785 = 1920, so the main row spans edge to edge with no gutter.

        Team name text leans toward the CAA box in the middle on both sides
        (away right-aligned, home left-aligned) so the two names converge —
        the source achieves this with a flex-row-reverse + items-start/items-end
        pair on the home box; this port sets alignValue directly instead.

        Simplification: the source wraps each band in an `overflow-hidden` mask
        div so the entrance reads as a wipe reveal. This port skips the masks
        and animates position only — the artboard's own clipping keeps anything
        that slides in from off-canvas invisible until it crosses the edge, but
        within the 1080 canvas the boxes are simply visible while still sliding
        toward their resting spot rather than wiped in. Visually close, not a
        pixel match.

        Each box Node's own y-key plus its children's own y-keys compound,
        matching the source where e.g. #home-logo tweens independently on top
        of its already-animating #home-box parent.
    -->
    <Artboard defaultStateMachineId="3:190" viewModelId="3:70" viewModelInstanceId="3:84"
              styleId="3:5" x="2020" y="0" width="1920" height="1080" name="Matchup" id="3:2">
        <LayoutComponentStyle name="Matchup Style" id="3:5"/>

        <Fill name="Matte" id="0:2391">
            <SolidColor colorValue="00000000" name="Color" id="0:2392"/>
        </Fill>

        <Node name="Band" id="3:10">

            <!-- Sponsor bar: centered pill, sport-dependent presented-by line + mark. -->
            <Node x="0" y="700" name="Sponsor Bar" id="3:11">
                <Text x="538" y="18" width="700" sizingValue="fixed" wrapValue="noWrap"
                      overflowValue="visible" alignValue="left" verticalAlignValue="top"
                      name="Sponsor Text" id="3:30">
                    <TextStylePaint fontSize="36" lineHeight="36" fontAssetId="1:50"
                                    name="Sponsor Text Style" id="3:45">
                        <Fill name="Fill" id="0:2393">
                            <SolidColor colorValue="FFFFFFFF" name="Color" id="0:2394"/>
                        </Fill>
                    </TextStylePaint>
                    <TextValueRun styleId="3:45" text="DREXEL BASKETBALL PRESENTED BY" name="Run" id="0:2395">
                        <DataBindContext sourcePathIds="3:70-3:80" propertyKey="268" id="0:2396"/>
                    </TextValueRun>
                </Text>

                <Image x="1318" y="36" scaleX="0.016" scaleY="0.016"
                       assetId="3:160" name="Sponsor Logo" id="3:40">
                    <DataBindContext sourcePathIds="3:70-3:81" propertyKey="206" id="0:2397"/>
                </Image>

                <Shape x="510" y="0" name="Sponsor Bar Panel" id="3:20">
                    <Rectangle width="900" height="72" originX="0" originY="0" name="Path" id="0:2398"/>
                    <Fill name="Fill" id="0:2399">
                        <SolidColor colorValue="FF141414" name="Color" id="0:2400"/>
                    </Fill>
                </Shape>
            </Node>

            <!-- Away box: knockout logo on the left, name right-aligned toward the CAA box. -->
            <Node x="0" y="772" name="Away Box" id="3:12">
