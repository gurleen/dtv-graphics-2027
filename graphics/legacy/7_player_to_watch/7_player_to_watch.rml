    </Artboard>

    <!--
        Zuume is the on-air face; both weights are embedded so the .riv is
        self-contained.
    -->
    <FontAsset file="assets/fonts/Zuume-Bold.ttf" name="Zuume Bold" id="1:50"/>
    <FontAsset file="assets/fonts/Zuume-Regular.ttf" name="Zuume Regular" id="1:51"/>

    <!--
        The knockout logo ships with the current team baked in and is exposed on
        the view model, so the player can substitute the matchup's mark at load
        through its asset handler.
    -->
    <ImageAsset file="assets/images/team_knockout_logo.png" name="Team Knockout Logo" id="1:60"/>
    <ImageAsset file="assets/images/steamfitters_local_420_logo.png" name="Sponsor Logo" id="1:61"/>

    <ViewModel defaultInstanceId="1:80" name="PlayerToWatch" id="1:70">
        <ViewModelPropertyString name="firstName" id="1:71"/>
        <ViewModelPropertyString name="lastName" id="1:72"/>
        <ViewModelPropertyString name="statText" id="1:73"/>
        <ViewModelPropertyColor name="teamColor" id="1:74"/>
        <ViewModelPropertyAssetImage name="teamLogo" id="1:75"/>
        <ViewModelPropertyBoolean name="isVisible" id="1:76"/>

        <ViewModelInstance exports="true" name="Default" id="1:80">
            <ViewModelInstanceString propertyValue="JUSTIN" viewModelPropertyId="1:71" id="0:2849"/>
            <ViewModelInstanceString propertyValue="MOORE" viewModelPropertyId="1:72" id="0:2850"/>
            <ViewModelInstanceString propertyValue="24 PTS, 8 REB, 6 AST, 3 STL&#10;IN WIN OVER VILLANOVA (11/15)" viewModelPropertyId="1:73" id="0:2851"/>
            <ViewModelInstanceColor propertyValue="FF07294D" viewModelPropertyId="1:74" id="0:2852"/>
            <ViewModelInstanceAssetImage propertyValue="1:60" viewModelPropertyId="1:75" id="0:2853"/>
            <ViewModelInstanceBoolean propertyValue="true" viewModelPropertyId="1:76" id="0:2854"/>
        </ViewModelInstance>
    </ViewModel>
</Rive>
