<Rive version="1" kind="fragment">
    <!--
        Player To Watch — port of dtv-graphics-2026/src/graphics/7_player_to_watch.

        Layout is a single 1920x145 band seated at y=850, split into three
        fixed panels that mirror the source's flex row:
            0    .. 500   team panel   (team colour, knockout logo, player name)
            500  .. 1420  note panel   (#D8D8D8, the operator's stat line)
            1420 .. 1920  sponsor panel(#D8D8D8, Steamfitters Local 420 mark)

        The entrance choreographs the panels and content independently.
        The Band node controls overall visibility and the exit fade.
    -->
    <Artboard defaultStateMachineId="1:90" viewModelId="1:70" viewModelInstanceId="1:80"
              styleId="1:5" width="1920" height="1080" name="Player To Watch" id="1:3">
        <LayoutComponentStyle name="Player To Watch Style" id="1:5"/>

        <!-- Transparent matte: the scene keys over the program video. -->
        <Fill name="Matte" id="0:2623">
            <SolidColor colorValue="00000000" name="Color" id="0:2624"/>
        </Fill>

        <!-- Declaration order is front-to-back: the first sibling draws on top. -->
        <Node name="Band" id="1:10">

            <!--
                Player name, over the knockout logo. Tailwind v4 registers
                --tw-leading with inherits:false, so the parent's leading-10 does
                not reach the two paragraphs: each falls back to line-height 1,
                giving 48px and 72px line boxes. The 120px stack is centred in the
                145px panel, so the line boxes sit at 862.5 and 910.5. Rive anchors
                a text box at its content-box top and puts the first baseline an
                ascender below, so y is the line box top plus the CSS half-leading,
                (lineHeight - fontSize) / 2, which is zero at line-height 1.
            -->
            <Text x="12" y="862.5" sizingValue="autoWidth" overflowValue="visible"
                  name="First Name" id="1:31">
                <TextStylePaint fontSize="48" lineHeight="48" fontAssetId="1:50"
                                name="First Name Style" id="1:40">
                    <Fill name="Fill" id="0:2625">
                        <SolidColor colorValue="FFFFFFFF" name="Color" id="0:2626"/>
                    </Fill>
                </TextStylePaint>
                <TextValueRun styleId="1:40" text="JUSTIN" name="Run" id="0:2627">
                    <DataBindContext sourcePathIds="1:70-1:71" propertyKey="268" id="0:2628"/>
                </TextValueRun>
            </Text>

            <Text x="12" y="910.5" sizingValue="autoWidth" overflowValue="visible"
                  name="Last Name" id="1:32">
                <TextStylePaint fontSize="72" lineHeight="72" fontAssetId="1:50"
                                name="Last Name Style" id="1:41">
                    <Fill name="Fill" id="0:2629">
                        <SolidColor colorValue="FFFFFFFF" name="Color" id="0:2630"/>
                    </Fill>
                </TextStylePaint>
                <TextValueRun styleId="1:41" text="MOORE" name="Run" id="0:2631">
                    <DataBindContext sourcePathIds="1:70-1:72" propertyKey="268" id="0:2632"/>
                </TextValueRun>
            </Text>

            <!--
                Knockout logo: the source draws the 1024px mark at 350x350 with a
                275px left and -100px top offset, clipped by the panel. Image has
                no width/height, so the size comes from scale (350/1024) and the
                panel shape is the clip source.
            -->
            <Image x="450" y="925" scaleX="0.341797" scaleY="0.341797"
                   assetId="1:60" name="Team Knockout Logo" id="1:30">
                <ClippingShape sourceId="1:20" name="Clip To Team Panel" id="0:2633"/>
                <DataBindContext sourcePathIds="1:70-1:75" propertyKey="206" id="0:2634"/>
            </Image>

            <!--
                Operator note. The source renders markdown and bolds the **spans**;
                this port draws it as one run in a single weight. To take the
                paragraph weight of the original instead, point the run's styleId
                at "1:43" (Zuume Regular).
            -->
            <Text x="532" y="850" width="856" height="145"
                  sizingValue="fixed" wrapValue="wrap" alignValue="center"
                  verticalAlignValue="middle" overflowValue="visible"
                  name="Note" id="1:33">
                <TextStylePaint fontSize="60" lineHeight="60" fontAssetId="1:50"
                                name="Note Bold Style" id="1:42">
                    <Fill name="Fill" id="0:2635">
                        <SolidColor colorValue="FF000000" name="Color" id="0:2636"/>
                    </Fill>
                </TextStylePaint>
                <TextStylePaint fontSize="60" lineHeight="60" fontAssetId="1:51"
                                name="Note Regular Style" id="1:43">
                    <Fill name="Fill" id="0:2637">
                        <SolidColor colorValue="FF000000" name="Color" id="0:2638"/>
                    </Fill>
                </TextStylePaint>
                <TextValueRun styleId="1:42" text="24 PTS, 8 REB, 6 AST, 3 STL&#10;IN WIN OVER VILLANOVA (11/15)" name="Run" id="0:2639">
                    <DataBindContext sourcePathIds="1:70-1:73" propertyKey="268" id="0:2640"/>
                </TextValueRun>
            </Text>

            <!--
                Sponsor mark, centred in the right panel. The crest is taller
                than it is wide, so height is the binding dimension: 125 of the
                panel's 145 rows, leaving a 10px margin top and bottom.
                1187x1325 at 125/1325 = 0.094340 gives 112x125.
            -->
            <Image x="1670" y="922.5" scaleX="0.094340" scaleY="0.094340"
                   assetId="1:61" name="Sponsor Logo" id="1:34"/>

            <!-- Panels, behind everything above. -->
            <Shape x="0" y="850" name="Team Panel" id="1:20">
                <Rectangle width="500" height="145" originX="0" originY="0" name="Path" id="0:2641"/>
                <Fill name="Fill" id="0:2642">
                    <SolidColor colorValue="FF07294D" name="Color" id="0:2643">
                        <DataBindContext sourcePathIds="1:70-1:74" propertyKey="37" id="0:2644"/>
                    </SolidColor>
                </Fill>
            </Shape>

            <Shape x="500" y="850" name="Note Panel" id="1:21">
                <Rectangle width="920" height="145" originX="0" originY="0" name="Path" id="0:2645"/>
                <Fill name="Fill" id="0:2646">
                    <SolidColor colorValue="FFD8D8D8" name="Color" id="0:2647"/>
                </Fill>
            </Shape>

            <Shape x="1420" y="850" name="Sponsor Panel" id="1:22">
                <Rectangle width="500" height="145" originX="0" originY="0" name="Path" id="0:2648"/>
                <Fill name="Fill" id="0:2649">
                    <SolidColor colorValue="FFD8D8D8" name="Color" id="0:2650"/>
                </Fill>
            </Shape>
        </Node>

        <!--
            Entrance: a 1.2s left-to-right panel build, followed by staggered
            name lifts, a drifting team mark, and a soft sponsor settle.
            Panel scale is anchored at each panel's left edge. Content has
            independent timing so type never stretches with the backgrounds.
            Hidden and Hold key the complete pose for repeatable playback.
        -->
        <LinearAnimation fps="60" duration="1" name="Hidden" id="1:103">
            <KeyedObject objectId="1:10" id="0:2651">
                <KeyedProperty propertyKey="13" id="0:2652">
                    <KeyFrameDouble value="0" frame="0" id="0:2653"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="18" id="0:2654">
