<!-- Carries the bonus boolean to a numeric opacity target as 0 or 1. -->
<DataConverterToNumber name="Bonus Visible" id="20:1064"/>
<!-- The shot clock is a string, so it is read as a number first; the mapper
     then yields 1 at 10 seconds or fewer and 0 at 11 or more, clamped, which
     is the opacity of the red chip drawn over the gold one. -->
<DataConverterGroup name="Shot Clock Warning" id="20:1067">
  <DataConverterGroupItem converterId="20:1065" id="0:2388"/>
  <DataConverterGroupItem converterId="20:1066" id="0:2389"/>
</DataConverterGroup>
<DataConverterToNumber name="Shot Clock Seconds" id="20:1065"/>
<DataConverterRangeMapper name="Shot Clock Warning Visible" id="20:1066" minInput="10" maxInput="11" minOutput="1" maxOutput="0" clampLower="true" clampUpper="true"/>
