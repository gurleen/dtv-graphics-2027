{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["packages", "apps", "graphics", "scripts/check_deps.ts", "scripts/build_riv.ts"],
  "exclude": ["apps/site/*.ts", "graphics/*/generate_*.ts", "graphics/*/conference_teams.ts", "packages/renderer", "apps/renderer/*.ts"]
}
